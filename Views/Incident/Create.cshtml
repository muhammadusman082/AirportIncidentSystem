@model AirportIncidentSystem.Models.Incident

@{
    ViewData["Title"] = "PAA - Incident Management System";
}

<!-- FontAwesome Icons & Google Font -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        background-color: #f3f4f6;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .portal-container {
        max-width: 720px;
        margin: 0 auto;
        padding: 12px;
    }

    .portal-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        background: #ffffff;
        overflow: hidden;
    }

    .portal-header {
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
        color: white;
        padding: 24px 20px;
    }

    .form-section-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #6c757d;
        letter-spacing: 0.8px;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 6px;
        margin-bottom: 16px;
        margin-top: 10px;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
        color: #495057;
    }

    .form-control, .form-select {
        border-left: none;
        padding: 12px;
        font-size: 0.95rem;
    }

        .form-control:focus, .form-select:focus {
            box-shadow: none;
            border-color: #ced4da;
        }

    .input-group:focus-within {
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        border-radius: 0.375rem;
    }

    .dynamic-card {
        background-color: #f8f9fa;
        border-left: 4px solid #0d6efd;
        border-radius: 8px;
    }

    /* Mobile Responsive Optimizations */
    @@media (max-width: 576px) {
        .portal-container {
            padding: 8px;
        }

        .portal-header {
            padding: 18px 16px;
        }

            .portal-header h3 {
                font-size: 1.25rem;
            }

        .card-body {
            padding: 16px !important;
        }

        .btn-submit {
            font-size: 1rem;
            padding: 14px;
        }
    }
</style>

<div class="portal-container my-2 my-md-4">
    <div class="card portal-card">
        <!-- Header -->
        <div class="portal-header d-flex align-items-center justify-content-between">
            <div>
                <h3 class="mb-1 fw-bold"><i class="fa-solid fa-plane-arrival me-2"></i>Incident Reporting Portal</h3>
                <small class="opacity-75">Pakistan Airport Authority - Management System</small>
            </div>
            <i class="fa-solid fa-shield-halved fa-2x opacity-50 d-none d-sm-block"></i>
        </div>

        <div class="card-body p-4">
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2 fa-lg"></i>
                    <div>@ViewBag.Message</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Create" method="post" id="incidentForm">

                <!-- Section 1: Classification -->
                <div class="form-section-title"><i class="fa-solid fa-list-check me-1"></i> Incident Classification</div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Select Incident Type <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-triangle-exclamation text-primary"></i></span>
                        <select asp-for="IncidentType" id="incidentTypeSelect" class="form-select" onchange="renderDynamicFields()" required>
                            <option value="">-- Select Category --</option>
                            <option value="medical">Medical Emergency</option>
                            <option value="baggage">Baggage Loss / Damage</option>
                            <option value="bird_strike">Bird Strike</option>
                        </select>
                    </div>
                </div>

                <!-- Section 2: General Details -->
                <div class="form-section-title"><i class="fa-solid fa-clock-rotate-left me-1"></i> General Details</div>
                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Date <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-regular fa-calendar"></i></span>
                            <input asp-for="IncidentDate" type="date" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Time <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-regular fa-clock"></i></span>
                            <input asp-for="IncidentTime" type="time" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Flight Number</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-plane-departure"></i></span>
                            <input asp-for="FlightNumber" class="form-control" placeholder="e.g. PK-303" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Location / Terminal</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Gate 4, Terminal 1" />
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Reported By (Officer Name/ID) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-user-shield"></i></span>
                            <input asp-for="ReportedBy" class="form-control" placeholder="Enter officer name or staff ID" required />
                        </div>
                    </div>
                </div>

                <!-- Section 3: Dynamic Category Fields -->
                <div id="dynamicContainer" class="p-3 dynamic-card mb-4" style="display:none;"></div>

                <!-- Hidden Input for Dynamic Details JSON -->
                <input type="hidden" asp-for="DynamicDetails" id="hiddenDynamicDetails" />

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm btn-submit">
                    <i class="fa-solid fa-paper-plane me-2"></i> Submit Incident Record
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function renderDynamicFields() {
        const type = document.getElementById('incidentTypeSelect').value;
        const container = document.getElementById('dynamicContainer');
        container.innerHTML = '';

        if (!type) {
            container.style.display = 'none';
            return;
        }

        container.style.display = 'block';

        if (type === 'medical') {
            container.innerHTML = `
                <div class="form-section-title mb-3"><i class="fa-solid fa-notes-medical me-1"></i> Medical Emergency Details</div>
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Passenger / Patient Name</label>
                        <input type="text" id="dyn_patient" class="form-control" placeholder="Full Name">
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Condition Description</label>
                        <input type="text" id="dyn_condition" class="form-control" placeholder="e.g. Fainted, Injury">
                    </div>
                </div>
            `;
        } else if (type === 'baggage') {
            container.innerHTML = `
                <div class="form-section-title mb-3"><i class="fa-solid fa-suitcase-rolling me-1"></i> Baggage Incident Details</div>
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Bag Tag Number</label>
                        <input type="text" id="dyn_tag" class="form-control" placeholder="e.g. TAG-90218">
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Belongings Description / Status</label>
                        <input type="text" id="dyn_desc" class="form-control" placeholder="Missing item details">
                    </div>
                </div>
            `;
        } else if (type === 'bird_strike') {
            container.innerHTML = `
                <div class="form-section-title mb-3"><i class="fa-solid fa-crow me-1"></i> Bird Strike Details</div>
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Aircraft Model</label>
                        <input type="text" id="dyn_aircraft" class="form-control" placeholder="e.g. Boeing 777">
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label fw-semibold">Damage Severity</label>
                        <select id="dyn_damage" class="form-select">
                            <option value="None">None</option>
                            <option value="Minor">Minor</option>
                            <option value="Severe">Severe</option>
                        </select>
                    </div>
                </div>
            `;
        }
    }

    document.getElementById('incidentForm').addEventListener('submit', function() {
        const type = document.getElementById('incidentTypeSelect').value;
        let data = {};

        if (type === 'medical') {
            data = {
                patient: document.getElementById('dyn_patient')?.value || '',
                condition: document.getElementById('dyn_condition')?.value || ''
            };
        } else if (type === 'baggage') {
            data = {
                tag: document.getElementById('dyn_tag')?.value || '',
                description: document.getElementById('dyn_desc')?.value || ''
            };
        } else if (type === 'bird_strike') {
            data = {
                aircraft: document.getElementById('dyn_aircraft')?.value || '',
                damage: document.getElementById('dyn_damage')?.value || ''
            };
        }

        document.getElementById('hiddenDynamicDetails').value = JSON.stringify(data);
    });
</script>